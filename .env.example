# Credenciais do Supabase para a API de recomendacao ler o banco do Gana.
# Copie este arquivo para `.env` e preencha. NUNCA versione o `.env` real.
#
# A service_role key e necessaria porque o servico le as tabelas server-side
# (book_cache, user_book, users) que estao protegidas por RLS — a publishable/
# anon key da "permission denied" nelas. Pegue em:
#   Supabase Dashboard > Project Settings > API > service_role (secret)
#
# Sem estas variaveis, a POC roda com os dados mock automaticamente.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY
