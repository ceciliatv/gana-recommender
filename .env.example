# Copie para `.env` e preencha. O `.env` nunca vai para o Git.
# Sem SUPABASE_URL/SUPABASE_SERVICE_KEY o serviço sobe com dados sintéticos.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role (lê tabelas protegidas por RLS do lado do servidor). Nunca no app.
SUPABASE_SERVICE_KEY=

# JWT secret do projeto (Settings > API > JWT Secret). Com ele, as rotas por
# usuário exigem o token do Supabase e o `sub` precisa ser o próprio usuário.
SUPABASE_JWT_SECRET=

# opcional, mas recomendado: a cota anônima da Google Books API acaba rápido
GOOGLE_BOOKS_API_KEY=

# sal da pseudonimização dos ids nos logs
GANA_LOG_SALT=troque-este-valor
